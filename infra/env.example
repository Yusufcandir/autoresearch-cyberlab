# Copy to .env (chmod 600). Never commit .env. Values here are placeholders.
ENVIRONMENT=development

# --- required -------------------------------------------------------------
# SQLite needs no server; Postgres is used by infra/compose.server.yaml.
DATABASE_URL=sqlite:///./var/cyberlab.db
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_LOCAL_ONLY
AUDIT_LOG_DESTINATION=file:./var/audit.jsonl
DATA_DIR=./var

# --- LLMs -----------------------------------------------------------------
# gemini (free tier, public data only) | ollama (local, private data) | fake (offline demo)
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated models to try when the main one is overloaded (see `cyberlab gemini-models`)
GEMINI_FALLBACK_MODELS=
# Hand over to the local Ollama model after Gemini has been busy this many seconds (0 = never)
GEMINI_HANDOVER_SECONDS=20
# After Gemini fails, stay on the local model this many seconds before trying Gemini again
GEMINI_COOLDOWN_SECONDS=600
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
LLM_TOKEN_BUDGET=0
# Optional contact for the OpenAlex/Crossref polite pool
LITERATURE_CONTACT_EMAIL=

# --- compute --------------------------------------------------------------
SCHEDULER_BACKEND=local_lock
USE_GPU=false
GPU_JOB_MAX_MINUTES=60
MAX_PROJECT_STORAGE_GB=50

# --- safety (keep these) --------------------------------------------------
SANDBOX_BACKEND=none
ALLOW_RESTRICTED_EXECUTION=false
APPROVAL_POLICY_VERSION=1

# --- docker compose only ----------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- Operations ---
# Health-check alerts: an ntfy topic URL (https://ntfy.sh/<secret-topic>) or a Slack/Discord webhook.
ALERT_WEBHOOK=
# Off-site backup target for scripts/backup.sh (rsync/scp), e.g. user@backup-host:/srv/cyberlab-backups/
BACKUP_REMOTE=
# Local backups kept
BACKUP_KEEP=14
