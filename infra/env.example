# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit real values.
# Production credentials come from the institutional secret store.
ENVIRONMENT=development
DATABASE_URL=postgresql://cyberlab:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/cyberlab
REDIS_URL=redis://127.0.0.1:6379/0
MLFLOW_TRACKING_URI=
ARTIFACT_STORE_URI=file:./artifacts
# gemini (free tier, public data only) or ollama (local, private data)
LLM_PROVIDER=gemini
LLM_TOKEN_BUDGET=0
SCHEDULER_BACKEND=none
SLURM_PARTITION=
GPU_JOB_MAX_MINUTES=60
MAX_PROJECT_STORAGE_GB=50
SANDBOX_BACKEND=none
ALLOW_RESTRICTED_EXECUTION=false
APPROVAL_POLICY_VERSION=0
AUDIT_LOG_DESTINATION=file:./audit.log
# Used by infra/compose.dev.yaml
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
