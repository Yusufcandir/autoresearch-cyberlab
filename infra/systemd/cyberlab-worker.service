[Unit]
Description=AutoResearch-CyberLab worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/autoresearch-cyberlab
EnvironmentFile=%h/autoresearch-cyberlab/.env
ExecStart=%h/.local/bin/uv run --locked cyberlab worker
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
